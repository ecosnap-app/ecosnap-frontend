# Copia este archivo a .env y llena los valores.
# El archivo .env NO se sube a GitHub (esta en .gitignore).
#
# Sin estos valores la app corre en modo demo: navega bien pero no guarda nada.
# Importante: estas variables se incrustan al COMPILAR, asi que despues de
# llenarlas hay que reiniciar con `npx expo start -c` y generar un APK nuevo.

# Supabase -> Project Settings -> API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# URL publica del BFF desplegado en Render, sin barra al final
# Ejemplo: https://ecosnap-bff.onrender.com
EXPO_PUBLIC_API_URL=
